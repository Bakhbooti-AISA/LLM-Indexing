ictly limited to Headquarters Marine Corps under 32 CFR"}, {"p": "/message/metadata/content_references/4/matched_text", "o": "append", "v": "\\ue201"}, {"p": "/message/metadata/content_references/4/end_idx", "o": "replace", "v": 730}, {"p": "/message/metadata/content_references/4/safe_urls", "o": "append", "v": ["https://simple.m.wikipedia.org/wiki/File%3ASeal_of_the_United_States_Marine_Corps.svg"]}, {"p": "/message/metadata/content_references/4/refs", "o": "truncate", "v": 0}, {"p": "/message/metadata/content_references/4/alt", "o": "replace", "v": "([Wikipedia](https://simple.m.wikipedia.org/wiki/File%3ASeal_of_the_United_States_Marine_Corps.svg))"}, {"p": "/message/metadata/content_references/4/type", "o": "replace", "v": "grouped_webpages"}, {"p": "/message/metadata/content_references/4/invalid", "o": "remove"}, {"p": "/message/metadata/content_references/4", "o": "append", "v": {"items": [{"title": "File:Seal of the United States Marine Corps.svg - Simple English Wikipedia, the free encyclopedia", "url": "https://simple.m.wikipedia.org/wiki/File%3ASeal_of_the_United_States_Marine_Corps.svg", "pub_date": null, "snippet": null, "attribution_segments": null, "supporting_websites": [], "refs": [{"turn_index": 1, "ref_type": "view", "ref_index": 0}], "hue": null, "attributions": null, "attribution": "Wikipedia"}], "error": null, "status": "done", "fallback_items": null, "style": null}}, {"p": "/message/metadata/content_references", "o": "truncate", "v": 5}, {"p": "/message/metadata/safe_urls", "o": "append", "v": ["https://simple.m.wikipedia.org/wiki/File%3ASeal_of_the_United_States_Marine_Corps.svg"]}]}  \n\nevent: delta\ndata: {"p": "/message/content/parts/0", "o": "append", "v": " 765.14(c)(1"}   \n\nevent: delta\ndata: {"p": "", "o": "patch", "v": [{"p": "/message/content/parts/0", "o": "append", "v": "); all other uses require written permission from the Secretary of the Navy \\ue200cite\\ue202turn0search2\\ue201.\\n\\n## Official Definition  \\nThe seal\\u2019s design specifications are codified in Executive Order No. 10538 of June 22, 1954, which authorized the emblem\\u2019s formal adoption and outlined its elements and inscriptions \\ue200cite\\ue202turn1view0\\ue201.\\n\\n## History and Adoption  \\nIn 1954, Marine Corps Commandant General Lemuel C. Shepherd Jr. requested an official seal design, and President Eisenhower approved it that year \\ue200cite"}, {"p": "/message/metadata/content_references", "o": "append", "v": [{"matched_text": "\\ue200cite\\ue202turn0search2\\ue201", "start_idx": 898, "end_idx": 917, "safe_urls": [], "refs": [], "alt": null, "prompt_text": null, "type": "hidden", "invalid": true}, {"matched_text": "\\ue200cite\\ue202turn1view0\\ue201", "start_idx": 1127, "end_idx": 1144, "safe_urls": [], "refs": [], "alt": null, "prompt_text": null, "type": "hidden", "invalid": true}, {"matched_text": "\\ue200cite", "start_idx": 1319, "end_idx": 1324, "safe_urls": [], "refs": [], "alt": null, "prompt_text": null, "type": "hidden", "invalid": true}]}]}   \n\ndata: {"type": "url_moderation", "url_moderation_result": {"full_url": "https://commons.wikimedia.org/wiki/File%3ASeal_of_the_United_States_Marine_Corps.svg?utm_source=chatgpt.com", "is_safe": true, "is_blocked": false}, "conversation_id": "688f93a6-a128-8330-8f2c-203efebb66ed", "message_id": "49dc5aa1-ed27-485c-b397-58a3a1d1cd8c"}\n\nevent: delta\ndata: {"v": [{"p": "/message/content/parts/0", "o": "append", "v": "\\ue202turn3view0\\ue201. The emblem as shown on the seal was formally adopted in 1955 as the Marine Corps\\u2019 official emblem, replacing the 1868 design only by updating the eagle figure \\ue200cite\\ue202turn3view0\\ue201.\\n\\n"}, {"p": "/message/metadata/content_references/5/safe_urls", "o": "append", "v": ["https://commons.wikimedia.org/wiki/File%3ASeal_of_the_United_States_Marine_Corps.svg?utm_source=chatgpt.com"]}, {"p": "/message/metadata/content_references/5/alt", "o": "replace", "v": "([commons.wikimedia.org](https://commons.w